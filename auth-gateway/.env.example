# Environment: development | test | production
APP_ENV=development

# Base URL of this Portal
PUBLIC_BASE_URL=http://localhost:8080

# Odoo Cloud Configuration (URL must be HTTPS in production)
ODOO_URL=https://mycompany.odoo.com
ODOO_DB=mycompany

# SQLite Database Location
DATABASE_URL=sqlite:///./data/gateway.db

# Encryption Key (Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_key_here

# Google Workspace OAuth Credentials
# Để trống GOOGLE_WORKSPACE_DOMAINS để cho phép mọi tài khoản Google, bao gồm Gmail cá nhân.
# Nếu cần giới hạn miền doanh nghiệp, điền danh sách cách nhau bởi dấu phẩy (ví dụ: mycompany.com,corp.com).
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_WORKSPACE_DOMAINS=

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_USERNAME=MyCompanyOdooBot
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Optional Cloudflare Tunnel Token
CLOUDFLARE_TUNNEL_TOKEN=

# AI Agent Integration (Gateway Mode: Gateway chạy port 8080, Agent chạy port 8000)
# Hai secret GATEWAY_TO_AGENT_SECRET và AGENT_TO_GATEWAY_SECRET phải khác nhau,
# tối thiểu 32 ký tự và khớp chính xác giữa Gateway và Agent.
ENABLE_AI_AGENT_FORWARDING=true
AI_AGENT_BASE_URL=http://localhost:8000
GATEWAY_TO_AGENT_SECRET=your_gateway_to_agent_secret_min32chars_here
AGENT_TO_GATEWAY_SECRET=your_agent_to_gateway_secret_min32chars_here
